# Copy to `.env` and fill in the values you need. Never commit `.env`.

# ---------------------------------------------------------------------------
# Server (Express API) — read at runtime, never exposed to the browser
# ---------------------------------------------------------------------------

# OpenRouter key for the Transfer Assistant and meeting summaries.
OPENROUTER_API_KEY=
# Optional: model for the Transfer Assistant (default: openrouter/auto).
OPENROUTER_ASSISTANT_MODEL=
# Optional: comma-separated fallback list of models for meeting summaries.
OPENROUTER_SUMMARY_MODELS=

# ElevenLabs key for speech-to-text in Delegate Sessions Summary.
ELEVENLABS_API_KEY=

# Optional: public URL of the deployment, sent to OpenRouter as HTTP-Referer.
APP_URL=
# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the SPA is served by the same server).
CORS_ORIGINS=
# Optional: requests per minute per IP for AI endpoints (default 10).
AI_RATE_LIMIT_PER_MINUTE=
# Optional: max audio upload size for meeting summaries (default 25mb).
MAX_AUDIO_UPLOAD=
# Optional: number of reverse-proxy hops to trust for client IPs (default 1).
TRUST_PROXY=
# Optional: port for `pnpm start` (default 3000).
PORT=

# ---------------------------------------------------------------------------
# Client (Firebase web app) — embedded in the browser bundle at build time.
# Leave empty to run in local demo mode (localStorage accounts, no cloud features).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
